# Copy to backend/.env and fill in. backend/.env is gitignored; never commit real keys.

# ---- Required for the agent ------------------------------------------------
# https://platform.openai.com/api-keys  (used for chat + embeddings)
OPENAI_API_KEY=

# ---- Optional (defaults shown) ----------------------------------------------
# Model names are configurable so you can switch without code changes.
OPENAI_MODEL=gpt-4o-mini
# Changing the embedding model also means changing vector(1536) in the migration.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1

# Matches docker-compose.yml. Local-only credentials, fine for dev.
DATABASE_URL=postgres://seated:seated@localhost:5432/seated?sslmode=disable
REDIS_URL=redis://localhost:6379/0

PORT=8080
APP_TIMEZONE=America/New_York
FRONTEND_ORIGIN=http://localhost:5173
SESSION_TTL=168h
# Set true when serving over HTTPS.
COOKIE_SECURE=false
AGENT_MAX_STEPS=8

# ---- Seed script (go run ./cmd/seed) -----------------------------------------
SEED_DEMO_EMAIL=stella@example.com
SEED_DEMO_PASSWORD=demo-password
# Leave empty to skip creating an admin account.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---- Not used yet (later phases) ---------------------------------------------
# Google Places API (server-side), for importing real restaurant data.
# GOOGLE_PLACES_API_KEY=
